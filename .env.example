# Transport Strategy
VOICE_TRANSPORT_DEFAULT=daily
VOICE_TRANSPORT_FALLBACK=livekit

# Daily.co WebRTC Credentials
DAILY_API_KEY=

# LiveKit WebRTC Credentials
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech-to-Text (STT) - Deepgram Nova-2
DEEPGRAM_API_KEY=

# Text-to-Speech (TTS) - Cartesia Sonic (<100ms)
CARTESIA_API_KEY=

# Primary LLM - Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Fallback LLMs
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Pathwisse CareerVoice Backend URL (for posting extracted signals)
CAREERVOICE_API_URL=https://careervoice.pathwisse.com

# Server Port
PORT=8000
