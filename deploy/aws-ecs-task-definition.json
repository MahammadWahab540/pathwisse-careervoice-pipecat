{
  "family": "careervoice-pipecat-voice-agent",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/CareerVoiceEcsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/CareerVoiceAppRunnerRuntimeRole",
  "containerDefinitions": [
    {
      "name": "pipecat-voice-agent",
      "image": "<AWS_ACCOUNT_ID>.dkr.ecr.<AWS_REGION>.amazonaws.com/careervoice-pipecat:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "PORT", "value": "8000" },
        { "name": "CAREERVOICE_API_URL", "value": "https://careervoice.pathwisse.com" },
        { "name": "VOICE_TRANSPORT_DEFAULT", "value": "daily" },
        { "name": "VOICE_TRANSPORT_FALLBACK", "value": "livekit" },
        { "name": "GEMINI_MODEL", "value": "gemini-2.0-flash" }
      ],
      "secrets": [
        { "name": "DAILY_API_KEY", "valueFrom": "arn:aws:secretsmanager:<AWS_REGION>:<AWS_ACCOUNT_ID>:secret:careervoice/daily-api-key" },
        { "name": "LIVEKIT_URL", "valueFrom": "arn:aws:secretsmanager:<AWS_REGION>:<AWS_ACCOUNT_ID>:secret:careervoice/livekit-url" },
        { "name": "LIVEKIT_API_KEY", "valueFrom": "arn:aws:secretsmanager:<AWS_REGION>:<AWS_ACCOUNT_ID>:secret:careervoice/livekit-api-key" },
        { "name": "LIVEKIT_API_SECRET", "valueFrom": "arn:aws:secretsmanager:<AWS_REGION>:<AWS_ACCOUNT_ID>:secret:careervoice/livekit-api-secret" },
        { "name": "DEEPGRAM_API_KEY", "valueFrom": "arn:aws:secretsmanager:<AWS_REGION>:<AWS_ACCOUNT_ID>:secret:careervoice/deepgram-api-key" },
        { "name": "CARTESIA_API_KEY", "valueFrom": "arn:aws:secretsmanager:<AWS_REGION>:<AWS_ACCOUNT_ID>:secret:careervoice/cartesia-api-key" },
        { "name": "GEMINI_API_KEY", "valueFrom": "arn:aws:secretsmanager:<AWS_REGION>:<AWS_ACCOUNT_ID>:secret:careervoice/gemini-api-key" },
        { "name": "ANTHROPIC_API_KEY", "valueFrom": "arn:aws:secretsmanager:<AWS_REGION>:<AWS_ACCOUNT_ID>:secret:careervoice/anthropic-api-key" },
        { "name": "OPENAI_API_KEY", "valueFrom": "arn:aws:secretsmanager:<AWS_REGION>:<AWS_ACCOUNT_ID>:secret:careervoice/openai-api-key" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/careervoice-pipecat",
          "awslogs-region": "<AWS_REGION>",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
